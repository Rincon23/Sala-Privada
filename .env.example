# Cloudflare Realtime: painel da Cloudflare -> Realtime -> Serverless SFU -> criar app.
# Cole aqui o App ID e o App Secret (token) do app criado.
REALTIME_APP_ID=
REALTIME_APP_SECRET=

# Senha opcional da sala. Vazio = entra só com o nome.
ROOM_PASSWORD=

# Câmera e telas param antes de passar do plano grátis do Cloudflare (1.000 GB/mês).
MONTHLY_LIMIT_GB=900

# Arquivos enviados na sala: somem depois de FILE_TTL_HOURS horas.
FILE_TTL_HOURS=24
FILE_MAX_GB=10
FILES_TOTAL_GB=50
