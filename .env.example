# Cloudflare Realtime: painel da Cloudflare -> Realtime -> Serverless SFU -> criar app.
# Cole aqui o App ID e o App Secret (token) do app criado.
REALTIME_APP_ID=
REALTIME_APP_SECRET=

# Conta de admin: cria e apaga servidores, escolhe quem entra em cada um, troca senhas e apaga contas.
# É criada sozinha na primeira vez; a senha dela é sempre esta (trocar aqui troca lá).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Senha da sala: pedida uma vez só, para criar conta. Vazio = qualquer pessoa com o link cria conta.
ROOM_PASSWORD=

# Câmera e telas param antes de passar do plano grátis do Cloudflare (1.000 GB/mês).
MONTHLY_LIMIT_GB=900

# Arquivos enviados na sala: somem depois de FILE_TTL_HOURS horas.
FILE_TTL_HOURS=24
FILE_MAX_GB=10
FILES_TOTAL_GB=50

# Imagens e arquivos mandados nos canais de texto ficam guardados para sempre; este é o limite de cada um.
CHAT_FILE_MAX_MB=25
