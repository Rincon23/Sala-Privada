# Cloudflare Realtime: painel da Cloudflare -> Realtime -> Serverless SFU -> criar app.
# Cole aqui o App ID e o App Secret (token) do app criado.
REALTIME_APP_ID=
REALTIME_APP_SECRET=

# E-mail do host: quem criar a conta com ele (e confirmar pelo link) é o host. Só o host cuida dos
# servidores (cria, apaga, troca o link de convite, tira e coloca membros) e dá e tira o cargo de admin.
ADMIN_EMAIL=

# E-mails de confirmar conta e de "Esqueci minha senha". Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=465, SMTP_USER=seu Gmail e SMTP_PASS=uma "senha de app" (exige verificação em duas
# etapas: myaccount.google.com/apppasswords). Sem SMTP_HOST, os e-mails só aparecem no log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente (opcional). Padrão: "Sala Privada <SMTP_USER>".
MAIL_FROM=
# Endereço do site nos links dos e-mails (opcional). Vazio = o endereço por onde a pessoa entrou.
PUBLIC_URL=https://live.rincon.dev.br

# Câmera e telas param antes de passar do plano grátis do Cloudflare (1.000 GB/mês).
MONTHLY_LIMIT_GB=900

# Imagens e arquivos mandados nos canais de texto ficam guardados para sempre; este é o limite de cada um.
CHAT_FILE_MAX_MB=25
